{
  "name": "@assistant/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "bash scripts/run-vitest.sh",
    "test:capture:schema": "bash scripts/run-vitest.sh src/schema/__tests__/capture-schema.test.ts src/schema/__tests__/capture-forward-migration.test.ts",
    "typecheck": "NODE_BIN=\"$(which -a node | grep -v node_modules | head -n 1)\" && \"$NODE_BIN\" ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@assistant/domain": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^3.2.0"
  }
}

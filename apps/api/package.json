{
  "name": "@assistant/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "test": "bash scripts/run-vitest.sh",
    "test:capture:e2e": "bash scripts/run-vitest.sh test/capture.e2e-spec.ts",
    "typecheck": "NODE_BIN=\"$(which -a node | grep -v node_modules | head -n 1)\" && \"$NODE_BIN\" ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@assistant/db": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.44.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "vitest": "^3.1.0"
  }
}
